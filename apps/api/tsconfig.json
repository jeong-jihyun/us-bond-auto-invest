{
  "compilerOptions": {
    "target": "ES2022",
    
    "moduleResolution": "bundler",
    "module": "preserve",
    "strict": true,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "jest"]
  },
  "include": ["src", "test", "api"]
}
