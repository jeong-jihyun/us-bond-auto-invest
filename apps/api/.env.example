# 사양서 10.1 기준 (Redis 대신 DB 트랜잭션 잠금 사용)
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/bond_auto
JWT_SECRET=replace_in_local_environment
CRON_SECRET=replace_in_local_environment
BROKER_PROVIDER=MOCK
IBKR_ENV=PAPER
AUTO_INVEST_ENABLED=false
LIVE_TRADING_ENABLED=false
DEFAULT_CURRENCY=USD
DEFAULT_MONTHLY_AMOUNT=100
CORS_ORIGINS=http://localhost:8081,https://us-bond-auto-invest.vercel.app
